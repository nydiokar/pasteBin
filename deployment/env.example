# Paste Server Configuration
# Copy this file to .env and fill in the values


# API key authentication (for HTTP Shortcuts and scripts)
API_KEY=

# ============================================================================
# SESSION SECRET
# ============================================================================
# Generate with: python scripts/generate_secret.py
# This is used to encrypt session cookies. Keep it secret!
# Example: QYROCXRXwK3WA91T49pMOAxLWAk-r_lF7jCkbNREFTMcIbgf7fSCYvRAXM5e7F5g...
SESSION_SECRET=REPLACE_WITH_OUTPUT_FROM_generate_secret_py

# ============================================================================
# PASSWORD HASH
# ============================================================================
# Generate with: python scripts/init_password.py
# This is the bcrypt hash of your login password (NOT the password itself!)
# Example: $2b$12$coAliSO0s6UIzIH5BjgTq.Um2wtd5zbL5OSDO1tfseBYp.3in1gP6
PASSWORD_HASH=REPLACE_WITH_OUTPUT_FROM_init_password_py

# ============================================================================
# DOMAIN (optional for local testing)
# ============================================================================
# For local testing: use "localhost"
# For production: use your DuckDNS domain like "your-name.duckdns.org"
DOMAIN=localhost

# ============================================================================
# FLASK ENVIRONMENT
# ============================================================================
# For local testing: use "development" (allows HTTP instead of HTTPS)
# For production: use "production" (forces HTTPS for security)
FLASK_ENV=development


